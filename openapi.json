{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops API",
    "description": "A clean, documented REST API in front of the Urja Meter Ops utility portal. See /docs for interactive exploration, and the project's PROTOCOL.md for how the underlying portal actually works.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/meters": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "List / search / filter meters",
        "description": "List meters with filters the portal's own UI can't combine (it only\noffers a single free-text box). Backed by our in-memory index, not a\nlive portal call \u2014 see PROTOCOL.md / README for why.",
        "operationId": "list_meters_api_v1_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Free-text match against meter ID or serial number.",
              "title": "Q"
            },
            "description": "Free-text match against meter ID or serial number."
          },
          {
            "name": "install_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Installed | Faulty | Decommissioned",
              "title": "Install Status"
            },
            "description": "Installed | Faulty | Decommissioned"
          },
          {
            "name": "phase_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "single | three",
              "title": "Phase Type"
            },
            "description": "single | three"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Make"
            }
          },
          {
            "name": "install_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "CT Operated | Whole Current",
              "title": "Install Type"
            },
            "description": "CT Operated | Whole Current"
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter to meters under this distribution transformer.",
              "title": "Dt Code"
            },
            "description": "Filter to meters under this distribution transformer."
          },
          {
            "name": "zone",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Zone code, e.g. Z-01.",
              "title": "Zone"
            },
            "description": "Zone code, e.g. Z-01."
          },
          {
            "name": "circle",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Circle"
            }
          },
          {
            "name": "division",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Division"
            }
          },
          {
            "name": "subdivision",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Subdivision"
            }
          },
          {
            "name": "substation",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Substation"
            }
          },
          {
            "name": "feeder",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Feeder"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedMeters"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/near": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Meters near a lat/lng point",
        "description": "Not something the portal can answer at all \u2014 it has no spatial\nquery. Straight-line (haversine) distance, sorted nearest-first.",
        "operationId": "meters_near_api_v1_meters_near_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Lat"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Lng"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Omit for no distance cap.",
              "title": "Radius Km"
            },
            "description": "Omit for no distance cap."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NearbyMeter"
                  },
                  "title": "Response Meters Near Api V1 Meters Near Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Get a single meter's nameplate, hierarchy and geo",
        "operationId": "get_meter_api_v1_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meter"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Consumption readings for a meter, with a computed usage summary",
        "description": "Raw readings from the portal are cumulative register values, not\ninterval usage \u2014 this endpoint returns both the raw readings *and* a\n`summary` with derived consumption (last - first) and the inferred\nreading resolution, since the portal's own granularity is inconsistent\nacross meters (see PROTOCOL.md).",
        "operationId": "get_meter_consumption_api_v1_meters__meter_id__consumption_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterConsumption"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transformers": {
      "get": {
        "tags": [
          "transformers"
        ],
        "summary": "List distribution transformers (DTs)",
        "description": "Each DT is enriched with `meter_count` / `status_breakdown` computed\nfrom the meter dataset \u2014 the portal's own DT listing doesn't include\neither.",
        "operationId": "list_transformers_api_v1_transformers_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedTransformers"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transformers/{code}": {
      "get": {
        "tags": [
          "transformers"
        ],
        "summary": "Get a single transformer",
        "operationId": "get_transformer_api_v1_transformers__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transformer"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "tags": [
          "hierarchy"
        ],
        "summary": "Full network hierarchy tree (zone -> ... -> DT)",
        "description": "Reconstructed from per-meter data, since the portal exposes the\nhierarchy only as a breadcrumb on each meter's own page, never as a\ntree. `data_quality_issues` surfaces DTs whose meters disagree on (or\nare missing) part of their upstream path \u2014 see PROTOCOL.md.",
        "operationId": "get_hierarchy_api_v1_hierarchy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchyTree"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Service + upstream portal health",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsumptionReading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "Naive local timestamp as reported by the portal (no timezone given \u2014 see PROTOCOL.md)."
          },
          "kwh": {
            "type": "number",
            "title": "Kwh",
            "description": "Cumulative active-energy register reading, not an interval delta."
          },
          "kvah": {
            "type": "number",
            "title": "Kvah",
            "description": "Cumulative apparent-energy register reading, not an interval delta."
          },
          "volt_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volt R",
            "description": "R-phase voltage at the time of the reading."
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "kwh",
          "kvah"
        ],
        "title": "ConsumptionReading"
      },
      "ConsumptionResolution": {
        "type": "string",
        "enum": [
          "sub_hourly",
          "daily",
          "unknown"
        ],
        "title": "ConsumptionResolution"
      },
      "ConsumptionSummary": {
        "properties": {
          "reading_count": {
            "type": "integer",
            "title": "Reading Count"
          },
          "resolution": {
            "$ref": "#/components/schemas/ConsumptionResolution",
            "description": "Inferred from the median gap between readings. The portal returns wildly different granularities per meter for no metadata-visible reason (see PROTOCOL.md) so callers should not assume a fixed interval."
          },
          "first_timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Timestamp"
          },
          "last_timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Timestamp"
          },
          "kwh_consumed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kwh Consumed",
            "description": "last.kwh - first.kwh over the returned window."
          },
          "kvah_consumed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kvah Consumed"
          },
          "avg_volt_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Volt R"
          },
          "min_volt_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Volt R"
          },
          "max_volt_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Volt R"
          }
        },
        "type": "object",
        "required": [
          "reading_count",
          "resolution"
        ],
        "title": "ConsumptionSummary"
      },
      "GeoPoint": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "title": "GeoPoint"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "portal_reachable": {
            "type": "boolean",
            "title": "Portal Reachable"
          },
          "session_active": {
            "type": "boolean",
            "title": "Session Active"
          },
          "meters_cache_age_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meters Cache Age Seconds"
          },
          "transformers_cache_age_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transformers Cache Age Seconds"
          }
        },
        "type": "object",
        "required": [
          "status",
          "portal_reachable",
          "session_active"
        ],
        "title": "HealthStatus"
      },
      "HierarchyDataQualityIssue": {
        "properties": {
          "dt_code": {
            "type": "string",
            "title": "Dt Code"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "dt_code",
          "description"
        ],
        "title": "HierarchyDataQualityIssue"
      },
      "HierarchyNode": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "level": {
            "type": "string",
            "title": "Level"
          },
          "meter_count": {
            "type": "integer",
            "title": "Meter Count"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/HierarchyNode"
            },
            "type": "array",
            "title": "Children"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "level",
          "meter_count"
        ],
        "title": "HierarchyNode"
      },
      "HierarchyRef": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "title": "HierarchyRef"
      },
      "HierarchyTree": {
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "total_meters": {
            "type": "integer",
            "title": "Total Meters"
          },
          "zones": {
            "items": {
              "$ref": "#/components/schemas/HierarchyNode"
            },
            "type": "array",
            "title": "Zones"
          },
          "data_quality_issues": {
            "items": {
              "$ref": "#/components/schemas/HierarchyDataQualityIssue"
            },
            "type": "array",
            "title": "Data Quality Issues"
          }
        },
        "type": "object",
        "required": [
          "generated_at",
          "total_meters",
          "zones"
        ],
        "title": "HierarchyTree"
      },
      "InstallStatus": {
        "type": "string",
        "enum": [
          "Installed",
          "Faulty",
          "Decommissioned"
        ],
        "title": "InstallStatus"
      },
      "InstallType": {
        "type": "string",
        "enum": [
          "CT Operated",
          "Whole Current"
        ],
        "title": "InstallType"
      },
      "Meter": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "serial_no": {
            "type": "string",
            "title": "Serial No"
          },
          "make": {
            "type": "string",
            "title": "Make"
          },
          "phase_type": {
            "$ref": "#/components/schemas/PhaseType"
          },
          "install_status": {
            "$ref": "#/components/schemas/InstallStatus"
          },
          "dt_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dt Code"
          },
          "install_type": {
            "$ref": "#/components/schemas/InstallType"
          },
          "build": {
            "type": "string",
            "title": "Build"
          },
          "hierarchy": {
            "$ref": "#/components/schemas/MeterHierarchy"
          },
          "geo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "hierarchy_complete": {
            "type": "boolean",
            "title": "Hierarchy Complete",
            "description": "False if any level of `hierarchy` was missing in the source data."
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "serial_no",
          "make",
          "phase_type",
          "install_status",
          "install_type",
          "build",
          "hierarchy",
          "hierarchy_complete"
        ],
        "title": "Meter",
        "description": "Full meter record, as reconstructed from the portal's bulk export."
      },
      "MeterConsumption": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "summary": {
            "$ref": "#/components/schemas/ConsumptionSummary"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/ConsumptionReading"
            },
            "type": "array",
            "title": "Readings"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "summary",
          "readings"
        ],
        "title": "MeterConsumption"
      },
      "MeterHierarchy": {
        "properties": {
          "zone": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HierarchyRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "circle": {
